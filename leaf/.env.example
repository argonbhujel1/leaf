# Leafletang Enterprises Public Website - Environment Variables
# Copy to .env and fill in production values
# On Vercel: set these in Project → Settings → Environment Variables

FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string-in-production

# --- Database (Aiven PostgreSQL on Vercel) ---
# Paste the full connection string from Aiven (Service → Overview → Connection URI)
# Example: postgres://avnadmin:PASSWORD@xxx.aivencloud.com:12345/defaultdb?sslmode=require
# Code auto-converts postgres:// → postgresql:// for SQLAlchemy
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

SITE_URL=https://leafletang.argan.com.np
SESSION_COOKIE_SECURE=True

# --- Admin notification email (contact form → admin mailbox) ---
# Inquiries are always saved to DB and shown in Admin → Inquiries.
# When mail is configured, a copy is also emailed to ADMIN_EMAIL.
ADMIN_EMAIL=admin@yourdomain.com

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-smtp-user@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-smtp-user@gmail.com

# Optional Redis for rate limiting in production
